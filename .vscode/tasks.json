{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run MERN Dev Servers",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run MERN Dev Servers (cmd)",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm run dev"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}